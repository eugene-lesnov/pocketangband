+
+static bool web_delete_save(const char *name)
+{
+	char path[sizeof(savefile)];
+	char panic[sizeof(savefile)];
+	char prompt[320];
+
+	if (!name) return false;
+	strnfmt(path, sizeof(path), "%s%s%s", ANGBAND_DIR_SAVE, PATH_SEP, name);
+	savefile_get_panic_name(panic, sizeof(panic), path);
+
+	strnfmt(prompt, sizeof(prompt), "Delete the save %s permanently?", name);
+	if (!get_check(prompt)) return false;
+
+	return web_delete_save_file(path, file_exists(panic) ? panic : NULL);
+}
+#endif
