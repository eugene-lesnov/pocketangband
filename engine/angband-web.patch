+static void web_find_free_slot(char *path, size_t len)
+{
+	unsigned int number = 0;
+	char name[32];
+	char panic[sizeof(savefile)];
+
+	do {
+		strnfmt(name, sizeof(name), "Slot %u", ++number);
+		path_build(path, len, ANGBAND_DIR_SAVE, name);
+		savefile_get_panic_name(panic, sizeof(panic), path);
+	} while (file_exists(path) || file_exists(panic));
+}
+
+static bool web_import_save(void)
+{
+	const char *staged = "/tmp/pocketband-import";
+	char path[sizeof(savefile)] = "";
+	bool imported = false;
+
+	if (web_stage_save_import(staged)) {
+		if (savefile_check_import(staged)) {
+			web_find_free_slot(path, sizeof(path));
+		}
+		imported = web_finish_save_import(staged, path[0] ? path : NULL);
+	}
+	file_delete(staged);
+	return imported;
+}
+
+static void web_export_save(const char *name)
+{
+	char path[sizeof(savefile)];
+	if (name) path_build(path, sizeof(path), ANGBAND_DIR_SAVE, name);
+	web_export_save_file(name ? path : NULL);
+}
+
+static bool web_delete_save(const char *name)
+{
+	char path[sizeof(savefile)];
+	char panic[sizeof(savefile)];
+	char prompt[320];
+
+	if (!name) return false;
+	strnfmt(path, sizeof(path), "%s%s%s", ANGBAND_DIR_SAVE, PATH_SEP, name);
+	savefile_get_panic_name(panic, sizeof(panic), path);
+
+	strnfmt(prompt, sizeof(prompt), "Delete the save %s permanently?", name);
+	if (!get_check(prompt)) return false;
+
+	return web_delete_save_file(path, file_exists(panic) ? panic : NULL);
+}
+#endif
