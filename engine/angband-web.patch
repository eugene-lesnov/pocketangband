+
+static void web_render_birth_choices(struct menu *menu)
+{
+	const struct birthmenu_data *data = menu_priv(menu);
+	bool race = menu == &race_menu;
+	bool preview = menu->browse_hook != NULL;
+	const char *title = race ? "Choose race" :
+		menu == &class_menu ? "Choose class" : "Choose stat method";
+	const char *summary = race ? NULL : player->race->name;
+	if (menu == &roller_menu)
+		summary = format("%s / %s", player->race->name, player->class->name);
+
+	web_set_menu(menu, menu->cursor, NULL);
+	web_set_birth_menu(title, summary, preview);
+	for (int i = 0; i < menu->count; i++) {
+		const char *detail;
+		if (preview) {
+			void (*old_hook)(uint8_t, const char *) = text_out_hook;
+			birth_help_text[0] = '\0';
+			text_out_hook = collect_birth_help;
+			menu->browse_hook(i, menu_priv(menu), NULL);
+			text_out_hook = old_hook;
+			detail = birth_help_text;
+		} else {
+			detail = i == BR_POINTBASED ? "Spend points to adjust your attributes." :
+				"Roll a random set of attributes.";
+		}
+		web_add_menu_row(i, data->items[i], detail, NULL, 0, true);
+	}
+	web_menu_action('=', "Birth options");
+	web_menu_action('?', "Help");
+	if (data->allow_random)
+		web_menu_action('*', race ? "Random race" : "Random class");
+	web_menu_action('@', "Random character");
+}
+#endif
