+		if (player->obj_k->dd && player->obj_k->ds) {
+			strnfmt(av, sizeof(av), "%dd%d", a->dd, a->ds);
+			strnfmt(bv, sizeof(bv), "%dd%d", b->dd, b->ds);
+			web_compare_values("Damage dice", a->dd ? av : "None", b->dd ? bv : "None", &count);
+		}
+		web_compare_numbers("Base armor class", a->ac, b->ac, &count);
+		if (player->obj_k->to_a)
+			web_compare_numbers("Enchantment to armor", object_to_ac(a), object_to_ac(b), &count);
+		if (player->obj_k->to_h)
+			web_compare_numbers("Enchantment to hit", object_to_hit(a), object_to_hit(b), &count);
+		if (player->obj_k->to_d)
+			web_compare_numbers("Enchantment to damage", object_to_dam(a), object_to_dam(b), &count);
+	}
+	for (int i = 0; i < (int)N_ELEMENTS(the_summary->propcats); i++) {
+		const struct prop_category *cat = &the_summary->propcats[i];
+		for (int j = 0; j < cat->n; j++) {
+			int k = cat->off + j;
+			bool known = is_ui_entry_for_known_rune(cat->entries[j], player);
+			wchar_t wide[80];
+			char label[320];
+			get_ui_entry_label(cat->entries[j], N_ELEMENTS(wide), false, wide);
+			size_t end = wcslen(wide);
+			while (end && wide[end - 1] == L' ') wide[--end] = 0;
+			if (wcstombs(label, wide, sizeof(label)) == (size_t)-1) continue;
+			web_comparison_value(av, sizeof(av), left->vals[k], known, i);
+			web_comparison_value(bv, sizeof(bv), right->vals[k], known, i);
+			web_compare_values(label, av, bv, &count);
+			if (i == 4 && (left->auxvals[k] == 1 || right->auxvals[k] == 1)) {
+				web_comparison_value(av, sizeof(av), left->auxvals[k], known, 1);
+				web_comparison_value(bv, sizeof(bv), right->auxvals[k], known, 1);
+				char sustain[352];
+				strnfmt(sustain, sizeof(sustain), "Sustain %s", label);
+				web_compare_values(sustain, av, bv, &count);
+			}
+		}
+	}
+	if (!count) web_add_results_entry("No differences in the compared properties.", NULL, false);
+	web_wait_for_back(WEB_INPUT_RESULTS_LIST);
+}
+
+static void web_equip_comparison(void)
+{
+	if (initialize_summary(player, &the_summary) || the_summary->nitems < 2) {
+		if (web_search_entry == WEB_SEARCH_COLLECT) return;
+		web_set_results_list("Equippable comparison");
+		web_add_results_entry("Two equippable items are needed for comparison.", NULL, false);
+		web_wait_for_back(WEB_INPUT_RESULTS_LIST);
+		return;
+	}
+	int count = the_summary->nitems;
+	if (web_search_entry >= count) return;
+	bool collecting = web_search_entry == WEB_SEARCH_COLLECT;
+	char **names = collecting ? NULL : mem_alloc(count * sizeof(*names));
+	for (int i = 0; i < count; i++) {
+		const struct equippable *item = &the_summary->items[i];
+		char name[256];
+		object_desc(name, sizeof(name), item->obj, ODESC_FULL | (collecting ? ODESC_NO_SEEN : 0) |
+			(item->src == EQUIP_SOURCE_STORE ? ODESC_STORE : 0), player);
+		if (collecting) {
+			web_add_search_entry(i, name, item->store_name ? item->store_name :
+				web_item_sources[item->src], NULL);
+		} else names[i] = string_make(name);
+	}
+	if (collecting) return;
+	int *indices = mem_alloc(count * sizeof(*indices));
+	struct menu m;
+	menu_init(&m, MN_SKIN_SCROLL, menu_find_iter(MN_ITER_STRINGS));
+	menu_setpriv(&m, count, names);
+	m.web_render = web_comparison_rows;
+	m.web_no_keyboard = true;
+	menu_layout(&m, &SCREEN_REGION);
+	int first = web_search_entry >= 0 ? web_search_entry : -1;
+	for (;;) {
+		int n = 0;
+		for (int i = 0; i < count; i++)
+			if (i != first) indices[n++] = i;
+		menu_set_filter(&m, indices, n);
+		char title[320];
+		if (first >= 0) strnfmt(title, sizeof(title), "Compare with %s", names[first]);
+		m.title = first < 0 ? "Compare an item" : title;
+		if (menu_select(&m, 0, false).type != EVT_SELECT) {
+			if (first < 0 || web_search_entry >= 0) break;
+			m.cursor = first;
+			first = -1;
+		} else if (first < 0) {
+			first = indices[m.cursor];
+			m.cursor = 0;
+		} else {
+			web_compare_pair(first, indices[m.cursor], names);
+		}
+	}
+	for (int i = 0; i < count; i++) string_free(names[i]);
+	mem_free(names);
+	mem_free(indices);
+}
