+#ifdef __EMSCRIPTEN__
+const char *web_property_value(int value, bool known, bool resistance)
+{
+	if (value == UI_ENTRY_UNKNOWN_VALUE)
+		return "Unknown";
+	if (value == 0 || value == UI_ENTRY_VALUE_NOT_PRESENT)
+		return known ? "None" : "Unknown";
+	if (resistance) {
+		if (value == UI_ENTRY_RESIST0_RES_VUL)
+			return "Resistance and vulnerability";
+		if (value >= 3)
+			return "Immune";
+		if (value < 0)
+			return "Vulnerable";
+		return "Resistant";
+	}
+	return "Active";
+}
+
+static void web_character_defenses(void)
+{
+	const char *groups[] = { "resistances", "abilities", "hindrances" };
+	const char *categories[] = { "CHAR_SCREEN1", NULL };
+	int count = player->body.count;
+	int *values = mem_alloc((count + 1) * sizeof(*values));
+	int *aux = mem_alloc((count + 1) * sizeof(*aux));
+	struct cached_object_data **gear = mem_zalloc(count * sizeof(*gear));
+	struct cached_player_data *innate = NULL;
+
+	for (size_t i = 0; i < N_ELEMENTS(groups); ++i) {
+		categories[1] = groups[i];
+		struct ui_entry_iterator *iter = initialize_ui_entry_iterator(
+			check_for_two_categories, categories, groups[i]);
+		for (int remaining = count_ui_entry_iterator(iter); remaining > 0; --remaining) {
+			struct ui_entry *entry = advance_ui_entry_iterator(iter);
+			struct ui_entry_combiner_funcs combiner;
+			int index = ui_entry_renderer_query_combiner(get_ui_entry_renderer_index(entry));
+			if (ui_entry_combiner_get_funcs(index, &combiner)) continue;
+
+			for (int slot = 0; slot < count; ++slot)
+				compute_ui_entry_values_for_object(entry, slot_object(player, slot),
+					player, &gear[slot], &values[slot], &aux[slot]);
+			compute_ui_entry_values_for_player(entry, player, &innate,
+				&values[count], &aux[count]);
+
+			int value, temporary;
+			combiner.vec_func(count + 1, values, aux, &value, &temporary);
+			bool known = is_ui_entry_for_known_rune(entry, player);
+			bool resistance = i == 0;
+			const char *effect = NULL;
+			if (temporary != 0 && temporary != UI_ENTRY_VALUE_NOT_PRESENT &&
+				temporary != UI_ENTRY_UNKNOWN_VALUE)
+				effect = web_property_value(temporary, true, resistance);
+
+			wchar_t label[64];
+			get_ui_entry_label(entry, N_ELEMENTS(label), false, label);
+			web_character_defense(groups[i], label, wcslen(label),
+				web_property_value(value, known, resistance), effect);
+			for (int slot = 0; slot <= count; ++slot) {
+				int source = values[slot];
+				if (!source || source == UI_ENTRY_UNKNOWN_VALUE ||
+						source == UI_ENTRY_VALUE_NOT_PRESENT) continue;
+				const char *property = web_property_value(source, true, resistance);
+				if (slot == count) {
+					web_character_defense_source("Innate", property);
+				} else {
+					const struct object *obj = slot_object(player, slot);
+					if (!obj) continue;
+					char name[256];
+					object_desc(name, sizeof(name), obj, ODESC_BASE, player);
+					web_character_defense_source(
+						format("%s (%s)", name, player->body.slots[slot].name), property);
+				}
+			}
+		}
+		release_ui_entry_iterator(iter);
+	}
+
+	if (innate) release_cached_player_data(innate);
+	for (int slot = 0; slot < count; ++slot)
+		if (gear[slot]) release_cached_object_data(gear[slot]);
+	mem_free(gear);
+	mem_free(aux);
+	mem_free(values);
+}
+
+void web_character_sheet(bool preview)
+{
+	web_set_character(player->full_name, player->race->name,
+		player->class->name, show_title(), player->lev, player->history,
+		player->chp, player->mhp, player->csp, player->msp,
+		player->class->magic.total_spells > 0);
+
+	for (size_t i = 1; i < N_ELEMENTS(panels); ++i) {
+		struct panel *panel = panels[i].panel();
+		for (size_t j = 0; j < panel->len; ++j) {
+			struct panel_line *line = &panel->lines[j];
+			if (!line->label || !*line->value) continue;
+			if (preview && streq(line->label, "Gold")) {
+				web_character_row(i, line->label, format("%d", z_info->start_gold));
+			} else if (preview || !streq(line->label, "Overweight") || weight_remaining(player) < 0) {
+				web_character_row(i, line->label, line->value);
+			}
+		}
+		panel_free(panel);
+	}
+	for (int stat = 0; stat < STAT_MAX; ++stat) {
+		char current[8], best[8], value[32], label[4];
+		cnv_stat(player->state.stat_use[stat], current, sizeof(current));
+		cnv_stat(player->state.stat_top[stat], best, sizeof(best));
+		strnfmt(label, sizeof(label), "%.3s", stat_names[stat]);
+		strnfmt(value, sizeof(value), "%s", current);
+		if (player->state.stat_use[stat] < player->state.stat_top[stat])
+			strnfmt(value, sizeof(value), "%s / %s", current, best);
+		web_character_row(0, label, value);
+		if (preview) {
+			char base[8];
+			cnv_stat(player->stat_max[stat], base, sizeof(base));
+			web_character_stat_breakdown(base, player->race->r_adj[stat],
+				player->class->c_adj[stat], player->state.stat_add[stat], best);
+		}
+	}
+	if (!preview) web_character_defenses();
+}
+#endif
