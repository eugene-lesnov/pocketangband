+static const char *web_knowledge_detail(const member_funcs *members, int oid)
+{
+	if (members->display_member == display_monster) {
+		int race_index = default_item_id(oid);
+		const struct monster_race *race = &r_info[race_index];
+		if (!race->rarity) return "Shape";
+		if (rf_has(race->flags, RF_UNIQUE))
+			return race->max_num ? "Alive" : "Dead";
+		return format("Kills: %d", l_list[race_index].pkills);
+	}
+	if (members->display_member == display_object) {
+		struct object_kind *kind = &k_info[oid];
+		bool ignoring = kind->aware ? kind_is_ignored_aware(kind) : kind_is_ignored_unaware(kind);
+		const char *note = get_autoinscription(kind, kind->aware);
+		if (!ignoring) return note;
+		return note ? format("Ignored · %s", note) : "Ignored";
