+#ifdef __EMSCRIPTEN__
+static bool check_import_blocks(ang_file *file)
+{
+	struct blockheader block;
+	uint8_t bytes[4096];
+
+	if (!check_header(file)) return false;
+
+	for (size_t i = 0; i < N_ELEMENTS(savers); i++) {
+		if (next_blockheader(file, &block) != 0 ||
+				!streq(block.name, savers[i].name) ||
+				block.version != savers[i].version ||
+				block.size < block.payload_size) return false;
+
+		bool description = i == 0;
+		if (description && !block.payload_size) return false;
+
+		uint32_t checksum = 0;
+		uint32_t payload_left = block.payload_size;
+		for (uint32_t left = block.size; left > 0;) {
+			size_t count = MIN(left, sizeof(bytes));
+			size_t payload_count = MIN(payload_left, count);
+			if (file_read(file, (char *)bytes, count) != (int)count) {
+				return false;
+			}
+			if (description && payload_count && payload_left == payload_count &&
+					bytes[payload_count - 1] != 0) return false;
+			for (size_t j = 0; j < payload_count; j++) {
+				checksum += bytes[j];
+			}
+			payload_left -= payload_count;
+			left -= count;
+		}
+		if (checksum != block.checksum) return false;
+	}
+
+	return next_blockheader(file, &block) == 1;
+}
+
+bool savefile_check_import(const char *path)
+{
+	ang_file *file = file_open(path, MODE_READ, FTYPE_TEXT);
+	if (!file) return false;
+	bool valid = check_import_blocks(file);
+	file_close(file);
+	return valid;
+}
+#endif
