+static const struct trap *explore_blocking_trap(struct player *p, struct loc grid)
+{
+	const struct trap *trap;
+
+	for (trap = square_trap(p->cave, grid); trap; trap = trap->next) {
+		if (trf_has(trap->flags, TRF_VISIBLE) &&
+				(trf_has(trap->flags, TRF_WEB) ||
+				 (trf_has(trap->flags, TRF_TRAP) && !player_is_trapsafe(p))))
+			return trap;
+	}
+	return NULL;
