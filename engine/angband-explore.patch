+int explore_direction(struct player *p, const char **reason)
+{
+	struct player_upkeep *upkeep = p->upkeep;
+	struct chunk *c = p->cave;
+	struct pfdistances *distances;
+	int i;
+
+	c->squares[p->grid.y][p->grid.x].explore_neighbors =
+		unknown_neighbors(c, p->grid);
+
+	if (upkeep->steps && upkeep->step_count > 0 &&
+			explore_can_enter(p, upkeep->path_dest) &&
+			explore_frontier(c, upkeep->path_dest)) {
+		int dir = upkeep->steps[upkeep->step_count - 1];
