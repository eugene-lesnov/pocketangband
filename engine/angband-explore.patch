+		for (grid.x = 1; grid.x < p->cave->width - 1; grid.x++) {
+			int turns = pfdistances_to_turncount(distances, grid);
+			if (turns > 0 && turns < best && explore_frontier(p, grid)) {
+				best = turns;
+				upkeep->path_dest = grid;
+			}
+		}
+	}
+	if (best < INT_MAX) {
+		upkeep->step_count = pfdistances_to_path(distances, upkeep->path_dest, &upkeep->steps);
+	}
+	release_pfdistances(distances);
+	if (upkeep->step_count <= 0) return 0;
+	return upkeep->steps[--upkeep->step_count];
+}
