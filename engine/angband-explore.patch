+		if (explore_can_enter(p, loc_sum(p->grid, ddgrid[dir])))
+			return dir;
+	}
+	mem_free(upkeep->steps);
+	upkeep->steps = NULL;
+	upkeep->step_count = 0;
+
+	for (i = 0; i < 8; ++i) {
+		struct loc grid = loc_sum(p->grid, ddgrid_ddd[i]);
+
+		if (square_in_bounds_fully(c, grid) && square_ispassable(c, grid)
+				&& explore_can_enter(p, grid) && explore_frontier(c, grid))
+			return ddd[i];
+	}
+
+	upkeep->path_dest = loc(-1, -1);
+	distances = prepare_distances(p, p->grid, true, false, &upkeep->path_dest);
+	upkeep->step_count = pfdistances_to_path(distances, upkeep->path_dest,
+			&upkeep->steps);
