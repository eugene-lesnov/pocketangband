+static bool explore_known_route(struct chunk *c, struct loc grid)
+{
+	return square_isknown(c, grid) && !square_isshop(c, grid) &&
+		(square_ispassable(c, grid) || square_iscloseddoor(c, grid) ||
+		 square_isrubble(c, grid) || square_isdamaging(c, grid));
