+static const char *explore_end_message(struct player *p, struct pfdistances *distances)
+{
+	enum { VISITED = -2 };
+	struct chunk *c = p->cave;
+	struct queue *pending = NULL;
+	struct loc grid;
+	const char *reason = "You have explored all reachable areas.";
+
+	for (grid.y = 1; grid.y < c->height - 1; ++grid.y) {
+		for (grid.x = 1; grid.x < c->width - 1; ++grid.x) {
+			if (!explore_known_route(c, grid) ||
+					pfdistances_to_turncount(distances, grid) >= 0 ||
+					!explore_frontier(c, grid))
+				continue;
+			if (!pending)
+				pending = q_new(c->height * c->width);
+			q_push_int(pending, grid_to_i(grid, c->width));
+			distances->rows[grid.y][grid.x] = VISITED;
+		}
+	}
+	if (!pending)
+		return reason;
+
+	reason = "Partly explored. Some known areas are out of reach.";
+	while (q_len(pending)) {
+		int i;
+		i_to_grid(q_pop_int(pending), c->width, &grid);
+		for (i = 0; i < 8; ++i) {
+			struct loc next = loc_sum(grid, ddgrid_ddd[i]);
+			if (!square_in_bounds_fully(c, next))
+				continue;
+			if (pfdistances_to_turncount(distances, next) >= 0) {
+				q_free(pending);
+				return explore_blocker(p, grid);
+			}
+			if (distances->rows[next.y][next.x] != VISITED &&
+					explore_known_route(c, next)) {
+				distances->rows[next.y][next.x] = VISITED;
+				q_push_int(pending, grid_to_i(next, c->width));
+			}
+		}
+	}
+	q_free(pending);
+	return reason;
+}
