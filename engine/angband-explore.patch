+static const char *explore_blocker(struct player *p, struct loc grid)
+{
+	struct chunk *c = p->cave;
+	const struct trap *trap = explore_blocking_trap(p, grid);
+
+	if (trap)
+		return trf_has(trap->flags, TRF_WEB) ?
+			"Partly explored. A web blocks the way." :
+			"Partly explored. A known trap blocks the way.";
+	if (square_iscloseddoor(c, grid)) {
+		if (sqinfo_has(square(c, grid)->info, SQUARE_EXPLORE_LOCKED))
+			return "Partly explored. You failed to pick a lock.";
+		return "Partly explored. A closed door remains.";
+	}
+	if (square_isrubble(c, grid))
+		return "Partly explored. Rubble blocks the way.";
+	return "Partly explored. There is no safe route.";
